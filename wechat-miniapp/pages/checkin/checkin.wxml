<view class="container">

  <!-- 连续打卡信息 -->
  <view class="streak-card">
    <view class="streak-icon">🔥</view>
    <view class="streak-info">
      <text class="streak-num">{{streak}}</text>
      <text class="streak-label">天连续打卡</text>
    </view>
    <view wx:if="{{checkedInToday}}" class="checked-badge">
      <text>今日已打卡 ✓</text>
    </view>
  </view>

  <!-- 心情选择 -->
  <view class="section-title">今天的心情怎么样？</view>
  <view class="emotion-grid">
    <view
      wx:for="{{emotions}}"
      wx:key="label"
      class="emotion-item {{selectedIndex === index ? 'selected' : ''}}"
      data-index="{{index}}"
      bindtap="selectEmotion"
    >
      <text class="emotion-emoji">{{item.emoji}}</text>
      <text class="emotion-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 备注 -->
  <view class="section-title">写点什么（可选）</view>
  <textarea
    class="note-input"
    placeholder="今天发生了什么？记录一下吧..."
    placeholder-class="note-placeholder"
    value="{{note}}"
    bindinput="onNoteInput"
    maxlength="200"
    auto-height
  />

  <!-- 提交按钮 -->
  <button
    class="submit-btn {{(selectedIndex < 0 || checkedInToday || isSubmitting) ? 'disabled' : ''}}"
    disabled="{{selectedIndex < 0 || checkedInToday || isSubmitting}}"
    bindtap="submit"
  >
    <text wx:if="{{checkedInToday}}">今日已打卡 ✓</text>
    <text wx:else>完成打卡</text>
  </button>

</view>
