.container {
  padding: 32rpx 24rpx;
  background-color: #F4F6FB;
  min-height: 100vh;
}

/* 连续打卡卡片 */
.streak-card {
  background: #5B8AF0;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 40rpx;
  box-shadow: 0 4rpx 20rpx rgba(91,138,240,0.3);
}
.streak-icon {
  font-size: 56rpx;
  margin-right: 24rpx;
}
.streak-info {
  flex: 1;
  display: flex;
  align-items: baseline;
}
.streak-num {
  font-size: 64rpx;
  font-weight: bold;
  color: #FFFFFF;
  margin-right: 8rpx;
}
.streak-label {
  font-size: 26rpx;
  color: rgba(255,255,255,0.8);
}
.checked-badge {
  background: rgba(255,255,255,0.2);
  border-radius: 30rpx;
  padding: 8rpx 20rpx;
  color: #FFFFFF;
  font-size: 24rpx;
}

/* 区块标题 */
.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 24rpx;
}

/* 情绪网格 */
.emotion-grid {
  display: flex;
  justify-content: space-between;
  margin-bottom: 40rpx;
}
.emotion-item {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 20rpx 12rpx;
  width: 18%;
  border: 3rpx solid transparent;
  transition: all 0.2s;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.emotion-item.selected {
  border-color: #5B8AF0;
  background: rgba(91,138,240,0.08);
}
.emotion-emoji {
  font-size: 48rpx;
  margin-bottom: 8rpx;
}
.emotion-label {
  font-size: 22rpx;
  color: #666666;
}
.emotion-item.selected .emotion-label {
  color: #5B8AF0;
  font-weight: 600;
}

/* 备注输入 */
.note-input {
  width: 100%;
  min-height: 160rpx;
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  font-size: 28rpx;
  color: #1C1C1E;
  line-height: 1.6;
  margin-bottom: 48rpx;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.04);
}
.note-placeholder { color: #C7C7CC; }

/* 提交按钮 */
.submit-btn {
  background-color: #5B8AF0;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 32rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: none;
  width: 100%;
  box-shadow: 0 4rpx 16rpx rgba(91,138,240,0.3);
}
.submit-btn::after { border: none; }
.submit-btn.disabled {
  background-color: #C7C7CC;
  box-shadow: none;
}
