/* ── 整体容器 ── */
.container {
  display: flex;
  flex-direction: column;
  height: 100vh;
  background-color: #F4F6FB;
  overflow: hidden;
}

/* ── 状态栏 ── */
.status-bar {
  text-align: center;
  font-size: 22rpx;
  padding: 8rpx 24rpx;
}
.status-bar.offline {
  background-color: #5B8AF0;
  color: #FFFFFF;
}

/* ── 消息列表 ── */
.msg-list {
  flex: 1;
  height: 0;
}
.msg-list-inner {
  padding: 24rpx 24rpx 0;
}

/* ── 消息行 ── */
.msg-row {
  display: flex;
  align-items: flex-end;
  margin-bottom: 24rpx;
}
.msg-row.user {
  flex-direction: row-reverse;
}
.msg-row.assistant {
  flex-direction: row;
}

/* ── 助手头像 ── */
.avatar {
  width: 72rpx;
  height: 72rpx;
  border-radius: 50%;
  background-color: #FFFFFF;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  margin-right: 16rpx;
  box-shadow: 0 2rpx 8rpx rgba(91,138,240,0.15);
}
.avatar-icon {
  font-size: 36rpx;
  line-height: 1;
}

/* ── 气泡容器 ── */
.bubble-wrap {
  display: flex;
  flex-direction: column;
  max-width: 72%;
}
.bubble-wrap.user { align-items: flex-end; }
.bubble-wrap.assistant { align-items: flex-start; }

/* ── 气泡 ── */
.bubble {
  padding: 20rpx 28rpx;
  border-radius: 24rpx;
  font-size: 30rpx;
  line-height: 1.6;
  word-break: break-word;
}
.bubble.user {
  background-color: #5B8AF0;
  color: #FFFFFF;
  border-bottom-right-radius: 6rpx;
}
.bubble.assistant {
  background-color: #FFFFFF;
  color: #1C1C1E;
  border-bottom-left-radius: 6rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}

/* ── 加载动画气泡 ── */
.bubble.loading-dots {
  opacity: 0.5;
  animation: fadeIn 0.4s ease;
}
.dots {
  font-size: 36rpx;
  letter-spacing: 4rpx;
  color: #8E8E93;
  animation: pulse 1.2s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 0.4; }
  50% { opacity: 1; }
}
@keyframes fadeIn {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 0.5; transform: translateY(0); }
}

/* ── 情绪标签 ── */
.emotion-tag {
  font-size: 22rpx;
  color: #5B8AF0;
  margin-top: 8rpx;
  padding: 4rpx 16rpx;
  background-color: rgba(91,138,240,0.1);
  border-radius: 20rpx;
  align-self: flex-start;
}

/* ── 底部留白 ── */
.bottom-spacer { height: 24rpx; }

/* ── 输入栏 ── */
.input-bar {
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  background-color: #FFFFFF;
  border-top: 1rpx solid #E5E5EA;
}
.input {
  flex: 1;
  height: 80rpx;
  padding: 0 28rpx;
  margin-right: 16rpx;
  background-color: #F4F6FB;
  border-radius: 40rpx;
  font-size: 30rpx;
  color: #1C1C1E;
}
.input-placeholder { color: #C7C7CC; }
.send-btn {
  flex-shrink: 0;
  width: 120rpx;
  height: 80rpx;
  line-height: 80rpx;
  background-color: #5B8AF0;
  color: #FFFFFF;
  font-size: 28rpx;
  border-radius: 40rpx;
  padding: 0;
  text-align: center;
  border: none;
}
.send-btn::after { border: none; }
.send-btn.disabled { background-color: #C7C7CC; }


/* ── 客户端工具入口 ── */
.tool-entry-wrap {
  padding: 12rpx 24rpx 0;
  background-color: #FFFFFF;
  border-top: 1rpx solid #E5E5EA;
}
.tool-entry-btn {
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 32rpx;
  background-color: rgba(91,138,240,0.12);
  color: #3E6FDE;
  font-size: 24rpx;
  border: none;
}
.tool-entry-btn::after { border: none; }
