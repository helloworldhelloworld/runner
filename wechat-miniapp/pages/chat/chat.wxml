<view class="container">
  <!-- 连接状态提示 -->
  <view wx:if="{{!isConnected}}" class="status-bar offline">
    <text>正在连接服务器...</text>
  </view>

  <!-- 消息列表 -->
  <scroll-view
    scroll-y
    scroll-into-view="{{scrollId}}"
    scroll-with-animation
    class="msg-list"
  >
    <view class="msg-list-inner">
      <block wx:for="{{messages}}" wx:key="id">
        <view id="{{item.id}}" class="msg-row {{item.role}}">

          <!-- 助手头像 -->
          <view wx:if="{{item.role === 'assistant'}}" class="avatar">
            <text class="avatar-icon">⚓</text>
          </view>

          <!-- 气泡 -->
          <view class="bubble-wrap {{item.role}}">
            <view class="bubble {{item.role}} {{item.isLoading && !item.content ? 'loading-dots' : ''}}">
              <text wx:if="{{item.isLoading && !item.content}}" class="dots">···</text>
              <text wx:else selectable>{{item.content}}</text>
            </view>
            <!-- 情绪标签 -->
            <text
              wx:if="{{item.emotion && !item.isLoading}}"
              class="emotion-tag"
            >{{item.emotion}}</text>
          </view>

        </view>
      </block>
      <!-- 底部留白，防止最后一条消息被输入栏遮挡 -->
      <view class="bottom-spacer"></view>
    </view>
  </scroll-view>

  <!-- 底部输入区 -->
  <view class="input-bar">
    <input
      class="input"
      placeholder="说说你的心事..."
      placeholder-class="input-placeholder"
      value="{{inputText}}"
      bindinput="onInput"
      bindconfirm="sendMessage"
      adjust-position
      cursor-spacing="20"
    />
    <button
      class="send-btn {{isSending ? 'disabled' : ''}}"
      disabled="{{isSending}}"
      bindtap="sendMessage"
    >发送</button>
  </view>
</view>
