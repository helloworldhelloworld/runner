<view class="container">

  <!-- 评分卡片 -->
  <view class="score-card">
    <view class="score-circle" style="border-color: {{severityColor}}">
      <text class="score-num" style="color: {{severityColor}}">{{score}}</text>
      <text class="score-label">得分</text>
    </view>
    <view class="severity-badge" style="background-color: {{severityColor}}">
      <text class="severity-text">{{severity}}</text>
    </view>
    <text class="scale-type-text">{{scaleType}} 测评结果</text>
  </view>

  <!-- AI 报告 -->
  <view wx:if="{{aiReport}}" class="report-card">
    <view class="report-header">
      <text>⚓ 心灵港湾的话</text>
    </view>
    <text class="report-text">{{aiReport}}</text>
  </view>

  <!-- 操作按钮 -->
  <view class="actions">
    <button class="btn-chat" bindtap="goChat">去和港湾倾诉 💬</button>
    <button class="btn-back" bindtap="goBack">返回测评列表</button>
  </view>

  <!-- 免责声明 -->
  <view class="disclaimer">
    <text>此结果仅供参考，不构成医学诊断。如有需要，请寻求专业心理健康帮助。</text>
  </view>
</view>
