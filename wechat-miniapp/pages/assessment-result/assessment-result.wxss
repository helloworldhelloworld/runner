.container {
  padding: 32rpx 24rpx;
  background-color: #F4F6FB;
  min-height: 100vh;
}

/* 评分卡片 */
.score-card {
  background: #FFFFFF;
  border-radius: 28rpx;
  padding: 48rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 32rpx;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.score-circle {
  width: 180rpx;
  height: 180rpx;
  border-radius: 50%;
  border: 6rpx solid #5B8AF0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin-bottom: 32rpx;
}
.score-num {
  font-size: 72rpx;
  font-weight: bold;
  line-height: 1;
}
.score-label {
  font-size: 24rpx;
  color: #8E8E93;
  margin-top: 4rpx;
}
.severity-badge {
  border-radius: 40rpx;
  padding: 12rpx 40rpx;
  margin-bottom: 20rpx;
}
.severity-text {
  color: #FFFFFF;
  font-size: 30rpx;
  font-weight: 600;
}
.scale-type-text {
  font-size: 26rpx;
  color: #8E8E93;
}

/* AI 报告 */
.report-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 32rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.report-header {
  font-size: 28rpx;
  font-weight: 600;
  color: #5B8AF0;
  margin-bottom: 20rpx;
  padding-bottom: 16rpx;
  border-bottom: 1rpx solid #F0F0F0;
}
.report-text {
  font-size: 28rpx;
  color: #1C1C1E;
  line-height: 1.8;
}

/* 按钮 */
.actions {
  display: flex;
  flex-direction: column;
  gap: 16rpx;
  margin-bottom: 32rpx;
}
.btn-chat {
  background-color: #5B8AF0;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: none;
  box-shadow: 0 4rpx 16rpx rgba(91,138,240,0.3);
}
.btn-chat::after { border: none; }
.btn-back {
  background-color: #FFFFFF;
  color: #5B8AF0;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border: none;
  box-shadow: 0 2rpx 8rpx rgba(0,0,0,0.06);
}
.btn-back::after { border: none; }

/* 免责声明 */
.disclaimer {
  font-size: 22rpx;
  color: #C7C7CC;
  text-align: center;
  line-height: 1.6;
  padding: 0 20rpx;
}
