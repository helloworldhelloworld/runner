<view class="container">
  <!-- 进度条 -->
  <view class="progress-wrap">
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{progress}}%"></view>
    </view>
    <text class="progress-text">{{currentIndex + 1}} / {{questions.length}}</text>
  </view>

  <!-- 标题 -->
  <view class="scale-title">{{title}}</view>

  <!-- 当前题目 -->
  <view wx:if="{{questions.length > 0}}" class="question-card">
    <text class="question-num">第 {{currentIndex + 1}} 题</text>
    <text class="question-text">{{questions[currentIndex].text}}</text>

    <!-- 选项 -->
    <view class="options">
      <view
        wx:for="{{options}}"
        wx:key="index"
        class="option {{answers[currentIndex] === index ? 'selected' : ''}}"
        data-index="{{index}}"
        bindtap="selectAnswer"
      >
        <view class="option-dot"></view>
        <text class="option-text">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 上一题 -->
  <view wx:if="{{currentIndex > 0}}" class="back-btn" bindtap="prevQuestion">
    <text>‹ 上一题</text>
  </view>

  <!-- 提交中遮罩 -->
  <view wx:if="{{isSubmitting}}" class="submitting">
    <text>正在生成报告...</text>
  </view>
</view>
