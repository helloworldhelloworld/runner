<view class="container">
  <view class="header">
    <text class="header-title">心理测评</text>
    <text class="header-sub">了解自己的心理状态，每项测评约 2-5 分钟</text>
  </view>

  <view wx:if="{{loading}}" class="loading">
    <text>加载中...</text>
  </view>

  <view wx:else>
    <view
      wx:for="{{scales}}"
      wx:key="key"
      class="scale-card"
      data-type="{{item.key}}"
      bindtap="startQuiz"
    >
      <view class="scale-icon">📋</view>
      <view class="scale-info">
        <text class="scale-title">{{item.title}}</text>
        <text class="scale-desc">{{item.description}}</text>
        <text class="scale-count">{{item.questionCount}} 道题</text>
      </view>
      <view class="scale-arrow">›</view>
    </view>
  </view>

  <view class="disclaimer">
    <text>声明：本测评仅供参考，不作为临床诊断依据。如有需要，请咨询专业医生。</text>
  </view>
</view>
