.container {
  padding: 32rpx 24rpx;
  background-color: #F4F6FB;
  min-height: 100vh;
}

.header {
  margin-bottom: 40rpx;
}
.header-title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1C1C1E;
  display: block;
  margin-bottom: 12rpx;
}
.header-sub {
  font-size: 26rpx;
  color: #8E8E93;
}

.loading {
  text-align: center;
  padding: 60rpx;
  color: #8E8E93;
}

.scale-card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  display: flex;
  align-items: center;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.06);
}
.scale-icon {
  font-size: 48rpx;
  margin-right: 24rpx;
  flex-shrink: 0;
}
.scale-info {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.scale-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 8rpx;
}
.scale-desc {
  font-size: 24rpx;
  color: #8E8E93;
  margin-bottom: 8rpx;
}
.scale-count {
  font-size: 22rpx;
  color: #5B8AF0;
}
.scale-arrow {
  font-size: 40rpx;
  color: #C7C7CC;
  margin-left: 16rpx;
}

.disclaimer {
  margin-top: 40rpx;
  padding: 24rpx;
  background: rgba(91,138,240,0.06);
  border-radius: 16rpx;
  font-size: 22rpx;
  color: #8E8E93;
  line-height: 1.6;
}
