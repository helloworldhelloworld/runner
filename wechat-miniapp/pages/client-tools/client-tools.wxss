.page {
  min-height: 100vh;
  background: #F4F6FB;
  padding: 24rpx;
  box-sizing: border-box;
}

.section {
  background: #FFFFFF;
  border-radius: 20rpx;
  padding: 24rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 4rpx 12rpx rgba(0, 0, 0, 0.04);
}

.section-title {
  font-size: 30rpx;
  font-weight: 600;
  color: #1C1C1E;
  margin-bottom: 16rpx;
}

.tool-list {
  display: flex;
  flex-direction: column;
  gap: 12rpx;
}

.tool-item {
  border: 1rpx solid #E5E5EA;
  border-radius: 14rpx;
  padding: 16rpx;
}

.tool-item.selected {
  border-color: #5B8AF0;
  background: rgba(91, 138, 240, 0.08);
}

.tool-name {
  font-size: 28rpx;
  color: #1C1C1E;
}

.tool-desc {
  margin-top: 6rpx;
  font-size: 24rpx;
  color: #666;
}

.param-input {
  width: 100%;
  min-height: 220rpx;
  border: 1rpx solid #E5E5EA;
  border-radius: 12rpx;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 26rpx;
  background: #FAFAFC;
}

.action-section {
  display: flex;
  justify-content: flex-end;
}

.run-btn {
  width: 220rpx;
  height: 80rpx;
  line-height: 80rpx;
  border-radius: 40rpx;
  background: #5B8AF0;
  color: #FFFFFF;
  font-size: 28rpx;
}

.run-btn::after {
  border: none;
}

.result-section {
  margin-bottom: 0;
}

.result-box {
  min-height: 220rpx;
  border: 1rpx solid #E5E5EA;
  border-radius: 12rpx;
  background: #FAFAFC;
  padding: 16rpx;
  box-sizing: border-box;
  font-size: 24rpx;
  line-height: 1.6;
  color: #333;
  white-space: pre-wrap;
  word-break: break-all;
}


.auth-card {
  border: 1rpx solid rgba(91, 138, 240, 0.2);
}

.auth-line {
  font-size: 24rpx;
  color: #4A4A4A;
  line-height: 1.7;
}
