/* 全局样式 — 心灵港湾 SoulHarbor */
page {
  font-family: -apple-system, "PingFang SC", "Helvetica Neue", sans-serif;
  font-size: 28rpx;
  color: #1C1C1E;
  background-color: #F4F6FB;
  box-sizing: border-box;
}

* {
  box-sizing: border-box;
  -webkit-tap-highlight-color: transparent;
}

/* 品牌色变量（通过 class 复用） */
.brand-bg   { background-color: #5B8AF0; }
.brand-text { color: #5B8AF0; }
.mint-bg    { background-color: #A8D5BA; }
.crisis-bg  { background-color: #FF6B6B; }

/* 通用卡片 */
.card {
  background: #FFFFFF;
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 2rpx 16rpx rgba(91,138,240,0.08);
  margin-bottom: 24rpx;
}

/* 通用按钮 */
.btn-primary {
  background-color: #5B8AF0;
  color: #FFFFFF;
  border-radius: 48rpx;
  font-size: 30rpx;
  height: 88rpx;
  line-height: 88rpx;
  text-align: center;
  border: none;
  width: 100%;
}
.btn-primary::after { border: none; }
.btn-primary.disabled { background-color: #C7C7CC; }
