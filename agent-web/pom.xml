<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0
         http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>com.lightweightai</groupId>
        <artifactId>lightweight-ai-kernel-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>

    <artifactId>agent-web</artifactId>
    <name>Agent Web</name>
    <description>Web interface for testing and debugging Lightweight AI Kernel</description>

    <dependencies>
        <!-- Internal dependencies -->
        <dependency>
            <groupId>com.lightweightai</groupId>
            <artifactId>agent-kernel</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lightweightai</groupId>
            <artifactId>agent-tools</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lightweightai</groupId>
            <artifactId>agent-mcp</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lightweightai</groupId>
            <artifactId>agent-sdk</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lightweightai</groupId>
            <artifactId>kernel-memory</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lightweightai</groupId>
            <artifactId>soul-safety</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lightweightai</groupId>
            <artifactId>soul-assessment</artifactId>
        </dependency>

        <dependency>
            <groupId>com.lightweightai</groupId>
            <artifactId>soul-user</artifactId>
        </dependency>

        <!-- SQLite for soul-user / soul-assessment -->
        <dependency>
            <groupId>org.xerial</groupId>
            <artifactId>sqlite-jdbc</artifactId>
            <version>3.44.1.0</version>
        </dependency>

        <!-- Spring Boot -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>

        <!-- WebSocket Support for Streaming -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-websocket</artifactId>
        </dependency>

        <!-- MCP Server Servlet transport (SSE + Streamable HTTP) -->
        <dependency>
            <groupId>io.modelcontextprotocol.sdk</groupId>
            <artifactId>mcp-spring-webmvc</artifactId>
            <optional>true</optional>
        </dependency>

        <!-- Jackson for JSON -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>

        <!-- Logging -->
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>

        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>

        <!-- Development tools -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-devtools</artifactId>
            <scope>runtime</scope>
            <optional>true</optional>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <version>${spring.boot.version}</version>
                <executions>
                    <execution>
                        <goals>
                            <goal>repackage</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
