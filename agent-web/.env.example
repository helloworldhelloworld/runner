# Claude 配置示例
# 复制此文件为 .env 并填入你的配置

# ========================================
# 方式一：使用Claude Pro会员（推荐）⭐
# ========================================
# 优点：使用Pro会员额度，无需额外付费
# 缺点：Session Key可能过期需要更新

# Provider类型：pro=使用Pro会员, api=使用官方API, mock=测试模式
PROVIDER_TYPE=pro

# Claude Session Key（从浏览器Cookie获取）
# 1. 登录 https://claude.ai
# 2. 按F12打开开发者工具
# 3. Application -> Cookies -> sessionKey
# 4. 复制sessionKey的值
CLAUDE_SESSION_KEY=your-session-key-here

# Organization ID（可选，会自动获取）
CLAUDE_ORG_ID=

# ========================================
# 方式二：使用Claude官方API
# ========================================
# 优点：稳定可靠，官方支持
# 缺点：按使用量付费

# Provider类型设置为api
# PROVIDER_TYPE=api

# Anthropic API密钥（从 https://console.anthropic.com/ 获取）
# ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# ========================================
# 方式三：使用OpenRouter（推荐用于解忧杂货铺）🌟
# ========================================
# 优点：支持多种模型（Claude, GPT-4, Gemini等），灵活切换
# 缺点：按使用量付费（但通常比官方API便宜）

# Provider类型设置为openrouter
# PROVIDER_TYPE=openrouter

# OpenRouter API密钥（从 https://openrouter.ai/ 获取）
# OPENROUTER_API_KEY=sk-or-your-api-key-here

# 默认模型（可在前端动态切换）
# OPENROUTER_MODEL=anthropic/claude-3.5-sonnet

# ========================================
# 使用说明
# ========================================
# 1. 选择一种配置方式（pro/api/openrouter）
# 2. 取消注释对应的PROVIDER_TYPE和密钥配置
# 3. 填入你的密钥
# 4. 在终端运行：./start-with-env.sh
#
# ========================================
# 方式四：语音服务配置 🎤
# ========================================
# 语音输入输出功能（可选）

# 语音服务提供商（openai/azure/mock）
# SPEECH_PROVIDER=openai

# ⚠️  重要：OpenAI Speech 需要单独的 OpenAI API Key
# OpenRouter key 不能用于 OpenAI Speech API！
#
# 获取 OpenAI API Key:
# 1. 访问 https://platform.openai.com/api-keys
# 2. 创建新的 API key (格式: sk-proj-xxx 或 sk-xxx)
# 3. 确保账户有余额
#
# OPENAI_SPEECH_KEY=sk-proj-...
# OPENAI_SPEECH_VOICE=nova  # nova=温柔, shimmer=活泼, onyx=沉稳

# Azure Speech Services (推荐中文情感TTS，支持SSML)
# SPEECH_PROVIDER=azure
# AZURE_SPEECH_KEY=your-azure-key
# AZURE_SPEECH_REGION=eastasia
# AZURE_SPEECH_VOICE=zh-CN-XiaoxiaoNeural  # 晓晓(女声)

# ========================================
# 推荐方式
# ========================================
# 开发测试：使用mock模式（无需密钥）
# 个人使用：使用OpenRouter（灵活，支持多模型+语音）
# 生产环境：使用官方API（稳定可靠）+ Azure语音
